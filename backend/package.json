{
  "name": "group-chat-search-backend",
  "version": "1.0.0",
  "type": "module",
  "description": "Backend API for Search a Group Chat Properly",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "generate:data": "node scripts/generateChat.js",
    "generate:embeddings": "node scripts/generateEmbeddings.js",
    "setup": "node scripts/generateChat.js && node scripts/generateEmbeddings.js",
    "test:search": "node scripts/runEvaluation.js",
    "test:duplicates": "node scripts/analyzeDuplicates.js"
  },
  "dependencies": {
    "@xenova/transformers": "^2.17.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "mongodb-memory-server": "^11.2.0",
    "mongoose": "^8.9.5"
  },
  "devDependencies": {
    "nodemon": "^3.1.9"
  }
}
